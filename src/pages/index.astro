<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Amaya Dental Clinic | Thoughtful dental care in Bengaluru</title>
  <meta name="description" content="Thoughtful dental care for every smile. Visit Amaya Dental in Vasanth Nagar or Sahakar Nagar, Bengaluru. Book a consultation or talk to us on WhatsApp."/>
  <link rel="canonical" href={siteOrigin + "/"}/>
  <meta property="og:type" content="website"/><meta property="og:site_name" content="Amaya Dental Clinic"/><meta property="og:title" content="Amaya Dental | A little more reason to smile"/><meta property="og:description" content="Thoughtful dental care in Vasanth Nagar & Sahakar Nagar, Bengaluru."/><meta property="og:url" content={siteOrigin + "/"}/><meta property="og:image" content={siteOrigin + "/social-preview.png?v=2"}/><meta property="og:image:type" content="image/png"/><meta property="og:image:secure_url" content={siteOrigin + "/social-preview.png?v=2"}/><meta property="og:image:alt" content="Amaya Dental Clinic: Good care, real people, more smiles"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Amaya Dental | A little more reason to smile"/><meta name="twitter:description" content="Thoughtful dental care in Vasanth Nagar & Sahakar Nagar, Bengaluru."/><meta name="twitter:image" content={siteOrigin + "/social-preview.png?v=2"}/>
