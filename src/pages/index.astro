const treatments = [
  ['01','Invisalign','A little more room to smile. Clear aligners, planned around you.','https://amayadental.in/invisalign-treatment-bangalore/'],
  ['02','Dental implants','Thoughtful options for replacing missing teeth.','https://amayadental.in/dental-implants-bangalore/'],
  ['03','Smile makeovers','A considered plan for the smile you have in mind.','https://amayadental.in/smile-makeovers-bangalore/'],
  ['04','Root canal care','Care for an affected tooth, with magnification when needed.','https://amayadental.in/microscopic-root-canal-treatment-bangalore/'],
  ['05','Children’s dentistry','A gentler introduction to looking after little teeth.','https://amayadental.in/pediatric-dentistry/'],
  ['06','Teeth whitening','Explore whether professional whitening is right for you.','https://amayadental.in/teeth-whitening-bangalore/'],
  ['07','Digital smile design','A way to plan and talk through possible changes together.','https://amayadental.in/digital-smile-designing-bangalore/'],
  ['08','TMJ & jaw care','For questions about jaw discomfort, clicking or tension.','https://amayadental.in/tmj-disorder-treatment-bangalore/'],
];
const whatsapp = 'https://wa.me/919591895500?text=Hello%20Amaya%20Dental%2C%20I%20would%20like%20to%20book%20a%20consultation.';
